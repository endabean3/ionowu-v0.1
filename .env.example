# ---------------------------------------------------------------------------
# CFG-04 — daftar lengkap variabel lingkungan aplikasi `ionowu-web`.
#
# File ini HANYA berisi nama variabel dan contoh bentuk nilainya. Nilai
# sungguhan tidak pernah ditulis di sini dan tidak pernah masuk Git (CFG-03):
# di produksi seluruh rahasia dipasok lewat secret manager, dan di mesin lokal
# lewat `.env.local` yang sudah diabaikan Git.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Identitas aplikasi ----------------------------------------------------
# Nama aplikasi resmi; jadi prefiks seluruh sumber daya (§3.4).
APP_NAME=ionowu-web
# Port publik yang dialokasikan di registry-port.md (NET-04). Isi dengan port
# yang benar-benar sudah terdaftar — jangan mengarang nomor sendiri.
APP_PORT=
# Versi yang sedang berjalan; diisi pipeline CI dari tag/commit.
APP_VERSION=0.0.0-dev
DEPLOY_ENVIRONMENT=development

# --- Situs publik ----------------------------------------------------------
# Dipakai Next.js membangun URL absolut untuk metadata Open Graph/Twitter.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (ISO-08) -----------------------------------------------------
# Database, user, dan kredensial khusus aplikasi. Koneksi runtime WAJIB memakai
# role ionowu_runtime, bukan owner database (lihat drizzle/roles/).
DATABASE_URL=postgres://ionowu_web_app:ganti-saya@ionowu-web-postgres:5432/ionowu_web
DATABASE_POOL_MAX=5
DATABASE_SSL=require
# URL terpisah khusus job migrasi; WAJIB memakai role owner (DAT-05).
DATABASE_MIGRATION_URL=postgres://ionowu_web_owner:ganti-saya@ionowu-web-postgres:5432/ionowu_web

# --- Tenant (DAT-08) -------------------------------------------------------
# Kosongkan untuk memakai tenant baku Ionowu (lihat src/db/tenant.ts).
TENANT_ID=

# --- Redis (ISO-09) --------------------------------------------------------
# Logical database dan prefiks kunci khusus aplikasi supaya tidak bertabrakan
# dengan aplikasi lain di instance Redis bersama.
REDIS_URL=redis://ionowu-web-redis:6379/3
REDIS_KEY_PREFIX=ionowu-web:

# --- Autentikasi admin (SEC-02) --------------------------------------------
# AUTH_URL wajib origin tetap; produksi memakai https://ionowu.com supaya
# Auth.js tidak menyusun callback dari header host permintaan.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
# Penyedia OIDC terpusat. Selama migrasi ke SSO internal belum selesai,
# Google OAuth masih dipakai sebagai penyedia.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Daftar email internal, dipisah koma.
ADMIN_EMAIL_ALLOWLIST=

# --- Formulir kontak & outbox ----------------------------------------------
RESEND_API_KEY=
# Alamat pengirim. KOSONG artinya masih memakai sandbox Resend
# (onboarding@resend.dev), yang HANYA bisa mengirim ke alamat yang
# mendaftarkan akun Resend -- notifikasi lead akan gagal permanen untuk
# semua penerima lain. Isi setelah domain ionowu.com diverifikasi di
# resend.com/domains, contoh: RESEND_FROM_EMAIL="Ionowu <kontak@ionowu.com>"
RESEND_FROM_EMAIL=
# Ke mana notifikasi lead dikirim. KOSONG = ke alamat kontak resmi
# (io@ionowu.com). Diisi HANYA sebagai penampung sementara ketika penyedia
# email membatasi tujuan -- mis. selama domain belum terverifikasi di Resend.
# Kosongkan lagi begitu batasan itu hilang.
CONTACT_NOTIFY_EMAIL=
# Melindungi POST /api/cron/outbox; tanpa ini worker selalu menolak.
CRON_SECRET=
# Melindungi GET /api/metrics yang dibaca Prometheus. Bila kosong, endpoint
# memakai CRON_SECRET sebagai cadangan supaya tidak pernah terbuka bebas.
METRICS_TOKEN=
# Sebaiknya BERBEDA dari CRON_SECRET; bila kosong limiter memakai CRON_SECRET.
RATE_LIMIT_SECRET=
# Isi HANYA dengan header yang dijamin ditimpa reverse proxy
# (cf-connecting-ip, true-client-ip, atau x-real-ip). Kosongkan kalau ragu.
CONTACT_TRUSTED_IP_HEADER=

# --- Observabilitas (OBS-01, OBS-02) ---------------------------------------
OTEL_SERVICE_NAME=ionowu-web
# Endpoint kolektor OTLP/HTTP. Di produksi (compose.yaml) diisi otomatis ke
# Jaeger di stack pemantauan; kosongkan hanya untuk mesin lokal tanpa
# kolektor -- OTel tetap aktif, trace_id di log tetap terbentuk, span-nya
# saja yang tidak terkirim ke mana pun.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# debug | info | warn | error (default: info di produksi)
LOG_LEVEL=info
