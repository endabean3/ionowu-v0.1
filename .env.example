# CFG-04 — salin nilai asli ke panel Environment Dokploy, jangan di-commit.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://ionowu.com
AUTH_URL=https://ionowu.com

# DAT-09 — WAJIB lewat PgBouncer, bukan langsung ke Postgres
DATABASE_URL=postgres://web_app:PASSWORD@ionowu-pgbouncer:5432/web
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# openssl rand -base64 32
AUTH_SECRET=
CRON_SECRET=
RATE_LIMIT_SECRET=

# Pihak ketiga
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
ADMIN_EMAIL_ALLOWLIST=
