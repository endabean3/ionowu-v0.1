{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tokens:check": "node scripts/validate-tokens.cjs --dir src",
    "check": "npm run typecheck && npm run lint && npm run tokens:check",
    "qa:visual": "playwright test",
    "qa:lighthouse": "node scripts/run-lighthouse.mjs",
    "qa": "npm run check && npm run build && npm run qa:visual && npm run qa:lighthouse"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
